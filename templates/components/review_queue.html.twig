<div {{ attributes }} class="review-queue-container">
    <h2 style="margin-top: 0; margin-bottom: 24px; font-size: 1.35rem; font-weight: 700;">
        Pending Data Verification Queue
    </h2>

    {% set claims = this.pendingClaims %}

    {% if claims is empty %}
    <div style="background-color: var(--bg-elevation-1); border: 1px solid var(--border-color); padding: 32px; text-align: center; border-radius: 6px; color: var(--text-muted);">
        🎉 Excellent! The review queue is empty. All AI-extracted financial data has been verified.
    </div>
    {% else %}
    <div style="display: flex; flex-direction: column; gap: 20px;">
        {% for claim in claims %}
            {% set revisions = this.getRevisionsForClaim(claim) %}
            {% set activeRevision = revisions|first %}

            <div style="
                    background-color: var(--bg-elevation-1);
                    border: 1px solid {% if claim.status == 'conflicting' %}#7f1d1d{% else %}var(--border-color){% endif %};
                    border-radius: 6px;
                    padding: 24px;
                    display: flex;
                    flex-direction: column;
                    gap: 16px;
            ">
                <!-- Claim card header -->
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                    <div>
                        <span style="font-size: 1.1rem; font-weight: bold; color: var(--text-primary);">
                            {{ claim.company.name }}
                        </span>
                        <span style="margin-left: 12px; color: var(--text-muted); font-size: 0.9rem;">
                            Period: <strong>{{ claim.period }}</strong> | Metric: <span class="metric-badge" style="background-color: var(--bg-elevation-2); padding: 2px 6px; border-radius: 4px;">{{ claim.metricName|upper }}</span>
                        </span>
                    </div>
                    <div>
                        {% if claim.status == 'conflicting' %}
                        <span style="background-color: #7f1d1d; color: #f87171; padding: 4px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">
                            ⚠ Data Conflict ({{ revisions|length }} Sources)
                        </span>
                        {% else %}
                        <span style="background-color: #78350f; color: #fbbf24; padding: 4px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">
                            Staged From AI
                        </span>
                        {% endif %}
                    </div>
                </div>

                <!-- Contents part: display revisions and Evidence -->
                <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                    {% if claim.status == 'conflicting' %}
                        {% for rev in revisions %}
                        <div style="flex: 1; min-width: 280px; background-color: var(--bg-main); border: 1px solid var(--border-color); padding: 16px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">Source file: <strong>{{ rev.source.fileName }}</strong></div>
                                <div style="font-size: 1.5rem; font-weight: 800; color: #f87171; margin-bottom: 12px;">
                                    {{ rev.extractedValue|number_format(2, '.', ',') }} <span style="font-size: 0.9rem; font-weight: normal; color: var(--text-muted)">{{ claim.currency }}</span>
                                </div>
                                <blockquote style="margin: 0; padding-left: 12px; border-left: 3px solid var(--accent-color); font-style: italic; font-size: 0.85rem; color: var(--text-muted);">
                                        "{{ rev.sourceLocatorExcerpt ?? 'No excerpt available in source file.' }}"
                                </blockquote>
                            </div>
                            <button data-action="live#action"
                                data-live-action-param="acceptRevision"
                                data-live-claim-id-param="{{ claim.id }}"
                                data-live-revision-id-param="{{ rev.id }}"
                                class="input-elevation-2"
                                style="margin-top: 16px; width: 100%; font-weight: bold; background-color: #064e3b; color: #34d399; border-color: #047857; cursor: pointer;"
                            >
                            Accept This Version
                            </button>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div style="flex: 2; min-width: 300px;">
                            <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 4px;">Extracted Value:</div>
                            <div style="font-size: 1.75rem; font-weight: 800; color: var(--accent-color); margin-bottom: 12px;">
                                {{ activeRevision.extractedValue|number_format(2, '.', ',') }} <span style="font-size: 1rem; font-weight: normal; color: var(--text-muted)">{{ claim.currency }}</span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px;">AI Evidence Context (Excerpt):</div>
                                <blockquote style="margin: 0; padding: 12px; background-color: var(--bg-main); border-left: 4px solid var(--accent-color); border-radius: 0 4px 4px 0; font-style: italic; font-size: 0.9rem; color: var(--text-muted);">
                                    "{{ activeRevision.sourceLocatorExcerpt ?? 'No text excerpt extracted by AI model.' }}"
                                </blockquote>
                            </div>
                            <div style="flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 10px; justify-content: center;">
                                <button data-action="live#action"
                                        data-live-action-param="acceptRevision"
                                        data-live-claim-id-param="{{ claim.id }}"
                                        data-live-revision-id-param="{{ activeRevision.id }}"
                                        class="input-elevation-2"
                                        style="font-weight: bold; background-color: #064e3b; color: #34d399; border-color: #047857; cursor: pointer; padding: 12px;"
                                >
                                    ✓ Approve Value
                                </button>
                                <button data-action="live#action"
                                        data-live-action-param="rejectClaim"
                                        data-live-claim-id-param="{{ claim.id }}"
                                        class="input-elevation-2"
                                        style="font-weight: bold; background-color: #7f1d1d; color: #f87171; border-color: #b91c1c; cursor: pointer; padding: 12px;"
                                >
                                    ✕ Reject Fact
                                </button>
                            </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
