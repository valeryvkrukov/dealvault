<div {{ attributes }} class="dashboard-container">
    <!-- Report Period Selector -->
    <div class="dashboard-toolbar">
        <span class="dashboard-toolbar-label">Reporting Period:</span>
        <select data-model="selectedPeriod" class="input-elevation-2 dashboard-select">
            <option value="2026-Q1">2026-Q1</option>
            <option value="2026-Q2">2026-Q2</option>
            <option value="2026-Q3">2026-Q3</option>
            <option value="2026-Q4">2026-Q4</option>
        </select>

        <span class="dashboard-loading" data-loading="show">
            Saving revision and recalculating completeness...
        </span>
    </div>

    <!-- Interactive B2B-table -->
    <table class="dashboard-table">
        <thead>
            <tr>
                <th class="dashboard-table-th">Company Name</th>
                <th class="dashboard-table-th">Reporting Status</th>
                <th class="dashboard-table-th">ARR (USD)</th>
                <th class="dashboard-table-th">Headcount</th>
            </tr>
        </thead>
        <tbody>
        {% for row in this.companies %}
            <tr class="dashboard-table-tr">
                <td class="dashboard-td-company">
                    <span>{{ row.entity.name }}</span>
                </td>
                <td class="dashboard-td-status">
                    {% if row.status == 'Validated' %}
                        <span class="status-validated">✓ Validated</span>
                    {% elseif row.status == 'Conflicting' %}
                        <span class="status-conflicting">⚠ Conflicting</span>
                    {% else %}
                        <span class="status-incomplete">⟳ Incomplete</span>
                    {% endif %}
                </td>

                <!-- Inline-edit cells -->
                {% for metricName in ['arr', 'headcount'] %}
                    <td class="dashboard-td-metric {% if loop.last %}dashboard-td-metric-last{% endif %}">
                        {% if row.metrics[metricName] is defined %}
                            {% set metric = row.metrics[metricName] %}

                            {% if this.editingClaimId == metric.claimId and metric.claimId is not null %}
                                <!-- Inline edit input -->
                                <input type="number"
                                       data-model="editingValue"
                                       data-action="blur->live#action"
                                       data-live-action-param="saveInlineEdit"
                                       data-action-keydown.enter="blur"
                                       class="input-elevation-2 dashboard-metric-input"
                                       autofocus>
                            {% else %}
                                <!-- Simple display of metric with completion indicator -->
                                <div data-action="click->live#action"
                                     data-live-action-param="startEditing"
                                     data-live-claim-id-param="{{ metric.claimId ?? '' }}"
                                     data-live-current-value-param="{{ metric.value }}"
                                     class="metric-badge-clickable {% if metric.state == 'Validated' %}badge-validated{% elseif metric.state == 'Conflicting' %}badge-conflicting{% else %}badge-missing{% endif %}"
                                     title="Click to edit value manually"
                                >
                                    {% if metric.state == 'Missing' %}
                                        Missing
                                    {% else %}
                                        {{ metric.value|number_format(0, '.', ',') }}
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% else %}
                            <span class="dashboard-toolbar-label">—</span>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="review-queue-empty">
                    No portfolio companies found for active tenant.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
