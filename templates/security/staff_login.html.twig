{% extends 'base.html.twig' %}

{% block title %}
    {{ 'login.staff_title'|trans }}
{% endblock %}

{% block body %}
<div class="card-elevation-1">
    <h2>{{ 'login.staff_title'|trans }}</h2>

    {% if error %}
        <div class="error-banner">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form action="{{ path('staff_login') }}" method="post">
        <div class="form-group">
            <label for="username" class="form-label">{{ 'login.email_label'|trans }}</label>
            <input type="email" id="username" name="_email" value="{{ last_username }}" class="input-elevation-2" required autofocus autocomplete="email">
        </div>

        <div class="form-group">
            <label for="password" class="form-label">{{ 'login.password_label'|trans }}</label>
            <input type="password" id="password" name="_password" class="input-elevation-2" required autocomplete="current-password">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn-accent">
            {{ 'login.submit_btn'|trans }}
        </button>
    </form>
</div>
{% endblock %}
